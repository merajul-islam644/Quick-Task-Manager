{"html":"<style>\n  /* Phone navigation screen: art direction for the GN-01 walkthrough */\n\n  /* Sidebar mock (desktop/tablet) */\n  .gn-side {\n    width: 252px;\n    flex: none;\n    background: hsl(var(--card));\n    border-right: 1px solid hsl(var(--border));\n    padding: calc(20px * var(--space-scale, 1));\n    display: flex;\n    flex-direction: column;\n    gap: calc(20px * var(--space-scale, 1));\n    position: relative;\n    overflow: hidden;\n  }\n  .gn-side-brand { display: flex; align-items: center; gap: calc(10px * var(--space-scale, 1)); }\n  .gn-side-name {\n    font-family: var(--font-heading);\n    font-weight: 700;\n    font-size: 16px;\n    letter-spacing: -0.02em;\n    color: hsl(var(--foreground));\n    line-height: 1.15;\n  }\n  .gn-nav { display: flex; flex-direction: column; gap: calc(2px * var(--space-scale, 1)); }\n  .gn-nav .ds-nav-item { justify-content: flex-start; gap: calc(10px * var(--space-scale, 1)); min-height: 44px; }\n  .gn-nav .ds-nav-item svg { width: 18px; height: 18px; flex: none; }\n  .gn-side-foot {\n    margin-top: auto;\n    padding-top: calc(16px * var(--space-scale, 1));\n    border-top: 1px dashed hsl(var(--border));\n    display: flex;\n    flex-direction: column;\n    gap: calc(8px * var(--space-scale, 1));\n  }\n  .gn-side-tag {\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    color: hsl(var(--primary-text));\n  }\n\n  /* Illustration: a small checklist, drawn from simple shapes */\n  .gn-illo { width: 100%; height: auto; display: block; }\n\n  /* The showcase: a framed phone beside the explanation */\n  .gn-stage {\n    display: grid;\n    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);\n    gap: calc(48px * var(--space-scale, 1));\n    align-items: center;\n    margin-top: calc(8px * var(--space-scale, 1));\n  }\n  .gn-phone-wrap { position: relative; display: flex; justify-content: center; }\n  .gn-phone {\n    width: 100%;\n    max-width: 320px;\n    border: 1px solid hsl(var(--border));\n    border-radius: calc(var(--radius) * 4);\n    background: hsl(var(--card));\n    box-shadow: 0 30px 60px -30px hsl(var(--main-900) / 0.35), 0 3px 8px -2px hsl(var(--main-900) / 0.12);\n    padding: calc(12px * var(--space-scale, 1));\n    position: relative;\n  }\n  .gn-notch {\n    width: 96px; height: 6px; border-radius: 99px;\n    background: hsl(var(--border));\n    margin: 0 auto calc(10px * var(--space-scale, 1));\n  }\n  .gn-ph-top {\n    display: flex; align-items: center; gap: calc(8px * var(--space-scale, 1));\n    padding-bottom: calc(10px * var(--space-scale, 1));\n    border-bottom: 1px solid hsl(var(--border));\n  }\n  .gn-ph-title {\n    font-family: var(--font-heading); font-weight: 700; font-size: 15px;\n    color: hsl(var(--foreground)); letter-spacing: -0.01em; line-height: 1.2;\n    flex: 1; min-width: 0;\n  }\n  .gn-ph-top .ds-menu-button { flex: none; border: 1px solid hsl(var(--border)); background: hsl(var(--muted)); border-radius: var(--radius-button); display: grid; place-items: center; width: 44px; height: 44px; }\n  .gn-ph-top .ds-menu-button svg { width: 20px; height: 20px; }\n  .gn-open {\n    margin-top: calc(10px * var(--space-scale, 1));\n    border: 1px solid hsl(var(--border));\n    border-radius: var(--radius);\n    background: hsl(var(--background));\n    padding: calc(8px * var(--space-scale, 1));\n    box-shadow: var(--shadow);\n  }\n  .gn-open-label {\n    font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;\n    color: hsl(var(--muted-foreground));\n    padding: 0 calc(8px * var(--space-scale, 1)) calc(6px * var(--space-scale, 1));\n  }\n  .gn-open .ds-nav-item { justify-content: flex-start; gap: calc(10px * var(--space-scale, 1)); min-height: 44px; width: 100%; }\n  .gn-open .ds-nav-item svg { width: 18px; height: 18px; flex: none; }\n  .gn-open .ds-theme-switch { margin: calc(6px * var(--space-scale, 1)) calc(8px * var(--space-scale, 1)) 0; }\n\n  /* Explanation column */\n  .gn-explain { display: flex; flex-direction: column; gap: calc(20px * var(--space-scale, 1)); }\n\n  /* Width ruler: a mini diagram with three breakpoint cards */\n  .gn-breaks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(12px * var(--space-scale, 1)); }\n  .gn-break {\n    border: 1px solid hsl(var(--border)); border-radius: var(--radius);\n    background: hsl(var(--card));\n    padding: calc(14px * var(--space-scale, 1));\n    display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1));\n  }\n  .gn-break-figure { height: 54px; display: flex; align-items: flex-end; justify-content: center; }\n  .gn-break-screen {\n    border-radius: 4px 4px 0 0;\n    background: hsl(var(--muted));\n    border: 1px solid hsl(var(--border));\n    border-bottom: 0;\n    display: flex; gap: 3px; padding: 4px;\n    height: 46px;\n    align-items: stretch;\n  }\n  .gn-break-bar {\n    width: 4px; border-radius: 2px; background: hsl(var(--primary) / 0.5); align-self: stretch;\n  }\n  .gn-break-col { flex: 1; display: flex; flex-direction: column; gap: 3px; }\n  .gn-break-line { height: 4px; border-radius: 2px; background: hsl(var(--border)); }\n  .gn-break h3 { margin: 0; font-size: 14px; font-weight: 650; color: hsl(var(--foreground)); }\n  .gn-break p { margin: 0; font-size: 13px; line-height: 1.4; color: hsl(var(--muted-foreground)); }\n  .gn-break .gn-bp-name { font-family: var(--font-heading); font-weight: 700; font-size: 12px; color: hsl(var(--primary-text)); letter-spacing: 0.04em; }\n\n  /* Tap-size rule card */\n  .gn-rule {\n    display: grid; grid-template-columns: auto 1fr; gap: calc(20px * var(--space-scale, 1));\n    align-items: center;\n    border: 1px solid hsl(var(--border)); border-radius: var(--radius);\n    padding: calc(16px * var(--space-scale, 1));\n    background: hsl(var(--card));\n  }\n  .gn-tap {\n    width: 64px; height: 64px; border-radius: var(--radius);\n    display: grid; place-items: center;\n    background: hsl(var(--primary) / 0.1);\n    border: 1px dashed hsl(var(--primary) / 0.5);\n    color: hsl(var(--primary-text));\n    font-family: var(--font-heading); font-weight: 700; font-size: 15px;\n  }\n  .gn-rule h3 { margin: 0 0 4px; font-size: 15px; font-weight: 650; color: hsl(var(--foreground)); }\n  .gn-rule p { margin: 0; font-size: 14px; line-height: 1.45; color: hsl(var(--muted-foreground)); }\n\n  /* Desktop shell showcase: banner showing the sidebar layout */\n  .gn-shot {\n    display: flex;\n    border: 1px solid hsl(var(--border));\n    border-radius: calc(var(--radius) * 2);\n    overflow: hidden;\n    background: hsl(var(--background));\n    box-shadow: var(--shadow);\n    min-height: 220px;\n  }\n  .gn-shot-main { flex: 1; min-width: 0; padding: calc(16px * var(--space-scale, 1)); display: flex; flex-direction: column; gap: calc(12px * var(--space-scale, 1)); }\n  .gn-shot-top {\n    display: flex; align-items: center; gap: calc(8px * var(--space-scale, 1));\n    padding-bottom: calc(10px * var(--space-scale, 1));\n    border-bottom: 1px solid hsl(var(--border));\n  }\n  .gn-shot-name { font-weight: 650; font-size: 14px; color: hsl(var(--foreground)); }\n  .gn-shot-top .ds-avatar { margin-left: auto; }\n  .gn-shot-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(8px * var(--space-scale, 1)); }\n  .gn-shot-card {\n    border: 1px solid hsl(var(--border)); border-radius: var(--radius);\n    padding: calc(10px * var(--space-scale, 1)); background: hsl(var(--card));\n    display: flex; flex-direction: column; gap: 2px;\n  }\n  .gn-shot-card span:first-child { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: hsl(var(--muted-foreground)); }\n  .gn-shot-card span:last-child { font-family: var(--font-heading); font-weight: 700; font-size: 20px; color: hsl(var(--foreground)); }\n  .gn-shot-row { display: flex; align-items: center; gap: 8px; padding: 6px 0; border-top: 1px solid hsl(var(--border)); }\n  .gn-shot-row .gn-dot { width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid hsl(var(--border)); flex: none; }\n  .gn-shot-row .gn-bar { height: 6px; border-radius: 3px; background: hsl(var(--muted)); flex: 1; }\n  .gn-shot-row .gn-bar.short { flex: 0 0 40%; }\n\n  .gn-caption {\n    display: flex; align-items: center; gap: calc(8px * var(--space-scale, 1));\n    font-size: 13px; color: hsl(var(--muted-foreground));\n  }\n  .gn-caption svg { width: 16px; height: 16px; flex: none; color: hsl(var(--primary-text)); }\n\n  .gn-note {\n    background: hsl(var(--primary) / 0.06);\n    border: 1px solid hsl(var(--primary) / 0.2);\n    border-radius: var(--radius);\n    padding: calc(14px * var(--space-scale, 1)) calc(16px * var(--space-scale, 1));\n    display: flex; gap: calc(12px * var(--space-scale, 1)); align-items: flex-start;\n  }\n  .gn-note svg { width: 18px; height: 18px; flex: none; color: hsl(var(--primary-text)); margin-top: 1px; }\n  .gn-note p { margin: 0; font-size: 14px; line-height: 1.5; color: hsl(var(--foreground)); }\n\n  @media (max-width: 960px) {\n    .gn-stage { grid-template-columns: 1fr; gap: calc(32px * var(--space-scale, 1)); }\n    .gn-phone-wrap { justify-content: flex-start; }\n  }\n  @media (max-width: 560px) {\n    .gn-breaks { grid-template-columns: 1fr; }\n    .gn-shot { display: none; }\n    .gn-rule { grid-template-columns: 1fr; justify-items: start; }\n    .gn-phone { max-width: 100%; }\n  }\n</style><main data-screen=\"compact-header-with-a-menu-on-phones\" data-eid=\"e1\">\n  <div class=\"ds-shell\" data-eid=\"e2\">\n    <div data-part=\"sidebar\" data-eid=\"e3\"></div>\n    <div class=\"ds-shell-main\" data-eid=\"e4\">\n      <div data-part=\"header\" data-eid=\"e5\"></div>\n\n      <div data-eid=\"content\">\n        <div class=\"ds-page\" style=\"padding-top: calc(24px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1))\" data-eid=\"e6\">\n          <div class=\"ds-page-head\" data-eid=\"e7\">\n            <div data-eid=\"e8\">\n              <span class=\"ds-eyebrow\" data-sample=\"GN-01.label\" data-eid=\"e9\">Move around on a phone</span>\n              <h1 class=\"ds-h1\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-eid=\"e10\">The same list, fitted to the screen</h1>\n              <p class=\"ds-muted\" style=\"margin: calc(6px * var(--space-scale, 1)) 0 0; max-width: 560px\" data-eid=\"e11\">A fixed sidebar on a desktop, a compact header with a menu on a phone. Home, Statistics and Settings are always one tap away.</p>\n            </div>\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e12\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M3 12l9-8 9 8\"></path><path d=\"M5 10v10h14V10\"></path></svg>\n              Go to Home\n            </a>\n          </div>\n\n          <div class=\"gn-stage\" data-eid=\"e13\">\n            <!-- LEFT: framed phone with the compact header and the open menu -->\n            <div class=\"gn-phone-wrap\" data-eid=\"e14\">\n              <div class=\"ds-deco\" style=\"left: -8%; top: 6%; width: 116%; height: 88%; border-radius: 50%; background: radial-gradient(circle at 50% 30%, hsl(var(--primary) / 0.14), transparent 68%);\" data-eid=\"e15\"></div>\n              <div class=\"gn-phone\" data-eid=\"e16\">\n                <div class=\"gn-notch\" aria-hidden=\"true\" data-eid=\"e17\"></div>\n                <div class=\"gn-ph-top\" data-eid=\"e18\">\n                  <a class=\"ds-brand-link\" data-goto=\"home\" aria-label=\"Quick Task Manager\" data-eid=\"e19\">\n                    <img class=\"ds-brand ds-brand-light\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/4db7d9fa-5751-4d03-a387-a03389ae8786/66bc4fc6-9829-4297-b579-36b98cd4b1c2/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e20\">\n                    <img class=\"ds-brand ds-brand-dark\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/f2f6488c-a0c3-4e6a-9786-e726fff29e15/106500fc-0028-44d1-a371-c9fae6669afd/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e21\">\n                  </a>\n                  <span class=\"gn-ph-title\" data-sample=\"\" data-eid=\"e22\">Quick Task Manager</span>\n                  <button class=\"ds-menu-button\" aria-label=\"Open the menu\" title=\"Open the menu\" data-eid=\"e23\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg>\n                  </button>\n                </div>\n\n                <div class=\"gn-open\" data-eid=\"e24\">\n                  <div class=\"gn-open-label\" data-sample=\"\" data-eid=\"e25\">Menu</div>\n                  <nav class=\"ds-nav\" data-eid=\"e26\">\n                    <a class=\"ds-nav-item ds-active\" data-goto=\"home\" data-eid=\"e27\">\n                      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M3 12l9-8 9 8\"></path><path d=\"M5 10v10h14V10\"></path></svg>\n                      Home\n                    </a>\n                    <a class=\"ds-nav-item\" data-goto=\"statistics\" data-eid=\"e28\">\n                      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"></path></svg>\n                      Statistics\n                    </a>\n                    <a class=\"ds-nav-item\" data-goto=\"settings\" data-eid=\"e29\">\n                      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z\"></path></svg>\n                      Settings\n                    </a>\n                  </nav>\n                  <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e30\">\n                    <button aria-label=\"Light\" data-eid=\"e31\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19\"></path></svg></button>\n                    <button class=\"ds-active\" aria-label=\"Dark\" data-eid=\"e32\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n                    <button aria-label=\"Auto\" data-eid=\"e33\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <!-- RIGHT: explanation of the whole move -->\n            <div class=\"gn-explain\" data-eid=\"e34\">\n              <div data-eid=\"e35\">\n                <h2 class=\"ds-h2\" style=\"margin: 0 0 calc(8px * var(--space-scale, 1))\" data-eid=\"e36\">One layout, three widths</h2>\n                <p class=\"ds-text\" style=\"margin: 0; color: hsl(var(--muted-foreground)); max-width: 520px\" data-eid=\"e37\">The sidebar holds the navigation on a wide screen. It folds into a compact header and a menu button on a phone, so the same list fits without any sideways scrolling.</p>\n              </div>\n\n              <div class=\"gn-breaks\" data-eid=\"e38\">\n                <div class=\"gn-break\" data-eid=\"e39\">\n                  <div class=\"gn-break-figure\" data-eid=\"e40\">\n                    <div class=\"gn-break-screen\" aria-hidden=\"true\" style=\"width: 100%\" data-eid=\"e41\">\n                      <div class=\"gn-break-bar\" data-eid=\"e42\"></div>\n                      <div class=\"gn-break-col\" data-eid=\"e43\"><div class=\"gn-break-line\" style=\"width: 70%\" data-eid=\"e44\"></div><div class=\"gn-break-line\" data-eid=\"e45\"></div><div class=\"gn-break-line\" data-eid=\"e46\"></div></div>\n                    </div>\n                  </div>\n                  <span class=\"gn-bp-name\" data-eid=\"e47\">Desktop</span>\n                  <h3 data-eid=\"e48\">Sidebar stays</h3>\n                  <p data-eid=\"e49\">Fixed on the left. Cards sit in columns.</p>\n                </div>\n                <div class=\"gn-break\" data-eid=\"e50\">\n                  <div class=\"gn-break-figure\" data-eid=\"e51\">\n                    <div class=\"gn-break-screen\" aria-hidden=\"true\" style=\"width: 78%\" data-eid=\"e52\">\n                      <div class=\"gn-break-bar\" data-eid=\"e53\"></div>\n                      <div class=\"gn-break-col\" data-eid=\"e54\"><div class=\"gn-break-line\" style=\"width: 60%\" data-eid=\"e55\"></div><div class=\"gn-break-line\" data-eid=\"e56\"></div></div>\n                    </div>\n                  </div>\n                  <span class=\"gn-bp-name\" data-eid=\"e57\">Tablet</span>\n                  <h3 data-eid=\"e58\">Sidebar, fewer columns</h3>\n                  <p data-eid=\"e59\">Navigation holds. Cards wrap into fewer columns.</p>\n                </div>\n                <div class=\"gn-break\" data-eid=\"e60\">\n                  <div class=\"gn-break-figure\" data-eid=\"e61\">\n                    <div class=\"gn-break-screen\" aria-hidden=\"true\" style=\"width: 52%\" data-eid=\"e62\">\n                      <div class=\"gn-break-col\" data-eid=\"e63\"><div class=\"gn-break-line\" style=\"width: 50%\" data-eid=\"e64\"></div><div class=\"gn-break-line\" data-eid=\"e65\"></div><div class=\"gn-break-line\" style=\"width: 80%\" data-eid=\"e66\"></div></div>\n                    </div>\n                  </div>\n                  <span class=\"gn-bp-name\" data-eid=\"e67\">Phone</span>\n                  <h3 data-eid=\"e68\">Compact header</h3>\n                  <p data-eid=\"e69\">App name and a menu button. Cards stack, one column.</p>\n                </div>\n              </div>\n\n              <div class=\"gn-rule\" data-eid=\"e70\">\n                <div class=\"gn-tap\" aria-hidden=\"true\" data-eid=\"e71\">44 px</div>\n                <div data-eid=\"e72\">\n                  <h3 data-eid=\"e73\">Easy to tap</h3>\n                  <p data-eid=\"e74\">Buttons and checkboxes stay at least 44 pixels tall, and no screen scrolls sideways at any width.</p>\n                </div>\n              </div>\n\n              <div class=\"gn-shot\" aria-hidden=\"true\" data-eid=\"e75\">\n                <div class=\"gn-side\" data-eid=\"e76\">\n                  <div class=\"gn-side-brand\" data-eid=\"e77\">\n                    <img class=\"ds-brand ds-brand-light\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/4db7d9fa-5751-4d03-a387-a03389ae8786/66bc4fc6-9829-4297-b579-36b98cd4b1c2/pikachu.png\" alt=\"\" data-eid=\"e78\">\n                    <img class=\"ds-brand ds-brand-dark\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/f2f6488c-a0c3-4e6a-9786-e726fff29e15/106500fc-0028-44d1-a371-c9fae6669afd/pikachu.png\" alt=\"\" data-eid=\"e79\">\n                    <span class=\"gn-side-name\" data-eid=\"e80\">Quick Task Manager</span>\n                  </div>\n                  <div class=\"gn-nav\" data-eid=\"e81\">\n                    <span class=\"ds-nav-item ds-active\" data-eid=\"e82\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 12l9-8 9 8\"></path><path d=\"M5 10v10h14V10\"></path></svg>Home</span>\n                    <span class=\"ds-nav-item\" data-eid=\"e83\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"></path></svg>Statistics</span>\n                    <span class=\"ds-nav-item\" data-eid=\"e84\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.7 1.7 0 0 0 .3 1.9 2 2 0 1 1-2.8 2.8 1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5 2 2 0 1 1-4 0 1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3 2 2 0 1 1-2.8-2.8 1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1 2 2 0 1 1 0-4 1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9 2 2 0 1 1 2.8-2.8 1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5 2 2 0 1 1 4 0 1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3 2 2 0 1 1 2.8 2.8 1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.5 1 2 2 0 1 1 0 4 1.7 1.7 0 0 0-1.5 1Z\"></path></svg>Settings</span>\n                  </div>\n                  <div class=\"gn-side-foot\" data-eid=\"e85\">\n                    <svg class=\"gn-illo\" viewBox=\"0 0 180 96\" fill=\"none\" aria-hidden=\"true\">\n                      <rect x=\"6\" y=\"12\" width=\"120\" height=\"18\" rx=\"5\" fill=\"hsl(var(--primary) / 0.12)\"></rect>\n                      <circle cx=\"18\" cy=\"21\" r=\"5\" fill=\"hsl(var(--success))\"></circle>\n                      <path d=\"M15.5 21l2 2 3-4\" stroke=\"hsl(var(--success-foreground))\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                      <rect x=\"28\" y=\"18\" width=\"72\" height=\"6\" rx=\"3\" fill=\"hsl(var(--primary) / 0.3)\"></rect>\n                      <rect x=\"6\" y=\"40\" width=\"120\" height=\"18\" rx=\"5\" fill=\"hsl(var(--muted))\"></rect>\n                      <circle cx=\"18\" cy=\"49\" r=\"5\" stroke=\"hsl(var(--border))\" stroke-width=\"1.75\"></circle>\n                      <rect x=\"28\" y=\"46\" width=\"58\" height=\"6\" rx=\"3\" fill=\"hsl(var(--border))\"></rect>\n                      <rect x=\"6\" y=\"68\" width=\"120\" height=\"18\" rx=\"5\" fill=\"hsl(var(--muted))\"></rect>\n                      <circle cx=\"18\" cy=\"77\" r=\"5\" stroke=\"hsl(var(--border))\" stroke-width=\"1.75\"></circle>\n                      <rect x=\"28\" y=\"74\" width=\"84\" height=\"6\" rx=\"3\" fill=\"hsl(var(--border))\"></rect>\n                      <circle cx=\"150\" cy=\"48\" r=\"22\" fill=\"hsl(var(--primary) / 0.1)\"></circle>\n                      <path d=\"M143 48l5 5 10-11\" stroke=\"hsl(var(--primary-text))\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                    </svg>\n                    <span class=\"gn-side-tag\" data-eid=\"e86\">Plan. Focus. Achieve.</span>\n                  </div>\n                </div>\n                <div class=\"gn-shot-main\" data-eid=\"e87\">\n                  <div class=\"gn-shot-top\" data-eid=\"e88\">\n                    <span class=\"gn-shot-name\" data-eid=\"e89\">Home</span>\n                    <span class=\"ds-avatar ds-avatar-sm\" data-sample=\"\" data-eid=\"e90\">MH</span>\n                  </div>\n                  <div class=\"gn-shot-cards\" data-eid=\"e91\">\n                    <div class=\"gn-shot-card\" data-eid=\"e92\"><span data-eid=\"e93\">Total</span><span data-eid=\"e94\">4</span></div>\n                    <div class=\"gn-shot-card\" data-eid=\"e95\"><span data-eid=\"e96\">Completed</span><span data-eid=\"e97\">1</span></div>\n                    <div class=\"gn-shot-card\" data-eid=\"e98\"><span data-eid=\"e99\">Pending</span><span data-eid=\"e100\">3</span></div>\n                  </div>\n                  <div class=\"gn-shot-row\" data-eid=\"e101\"><span class=\"gn-dot\" data-eid=\"e102\"></span><span class=\"gn-bar\" data-eid=\"e103\"></span></div>\n                  <div class=\"gn-shot-row\" data-eid=\"e104\"><span class=\"gn-dot\" style=\"border-color: hsl(var(--success)); background: hsl(var(--success) / 0.18)\" data-eid=\"e105\"></span><span class=\"gn-bar short\" data-eid=\"e106\"></span></div>\n                </div>\n              </div>\n\n              <div class=\"gn-caption\" data-eid=\"e107\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M12 16v-4M12 8h.01\"></path></svg>\n                <span data-eid=\"e108\">The menu on a phone also holds the colour mode switch, so no screen loses its toggle.</span>\n              </div>\n\n              <div class=\"gn-note\" data-eid=\"e109\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M9 11l3 3 8-8\"></path><path d=\"M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9\"></path></svg>\n                <p data-eid=\"e110\">Home is selected first. Reaching Statistics or Settings is one menu choice away, and the chosen screen closes the menu.</p>\n              </div>\n\n              <div class=\"ds-actions\" data-eid=\"e111\">\n                <a class=\"ds-btn ds-btn-ghost\" data-goto=\"statistics\" data-eid=\"e112\">See Statistics</a>\n                <a class=\"ds-btn ds-btn-secondary\" data-goto=\"settings\" data-eid=\"e113\">Open Settings</a>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Situation: an empty task list, so the same layout holds up when there is nothing to show -->\n      <section data-state=\"empty\" data-replaces=\"content\" hidden=\"\" data-eid=\"e114\">\n        <div class=\"ds-page\" style=\"padding-top: calc(24px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1))\" data-eid=\"e115\">\n          <div class=\"ds-page-head\" data-eid=\"e116\">\n            <div data-eid=\"e117\">\n              <span class=\"ds-eyebrow\" data-sample=\"GN-01.label\" data-eid=\"e118\">Move around on a phone</span>\n              <h1 class=\"ds-h1\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-eid=\"e119\">The same list, fitted to the screen</h1>\n              <p class=\"ds-muted\" style=\"margin: calc(6px * var(--space-scale, 1)) 0 0; max-width: 560px\" data-eid=\"e120\">A fixed sidebar on a desktop, a compact header with a menu on a phone. Home, Statistics and Settings are always one tap away.</p>\n            </div>\n            <a class=\"ds-btn\" data-goto=\"home\" data-eid=\"e121\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M3 12l9-8 9 8\"></path><path d=\"M5 10v10h14V10\"></path></svg>\n              Go to Home\n            </a>\n          </div>\n\n          <div class=\"ds-card\" style=\"margin-top: calc(24px * var(--space-scale, 1))\" data-eid=\"e122\">\n            <div class=\"ds-empty\" style=\"padding: calc(32px * var(--space-scale, 1)) calc(16px * var(--space-scale, 1))\" data-eid=\"e123\">\n              <span class=\"ds-empty-icon\" data-eid=\"e124\">\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"></path></svg>\n              </span>\n              <b style=\"color: hsl(var(--foreground))\">No tasks here. Add a task to get started!</b>\n              <span data-eid=\"e125\">Home is on the menu. Add your first task and the layout settles into place at every width.</span>\n              <a class=\"ds-btn ds-btn-sm\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-goto=\"home\" data-eid=\"e126\">Add a task</a>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  </div>\n</main>","changes":[]}