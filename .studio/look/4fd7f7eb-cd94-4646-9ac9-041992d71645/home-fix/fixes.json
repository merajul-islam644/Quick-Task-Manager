{"html":"<style>\n  /* ---------- Shell & page ---------- */\n  .q-page { padding-top: calc(24px * var(--space-scale, 1)); padding-bottom: calc(64px * var(--space-scale, 1)); }\n\n  /* ---------- Page head ---------- */\n  .q-head { display: grid; gap: calc(8px * var(--space-scale, 1)); }\n  .q-head-top { display: flex; flex-wrap: wrap; align-items: flex-end; gap: calc(16px * var(--space-scale, 1)); justify-content: space-between; }\n  .q-head h1 { margin: 0; letter-spacing: -0.02em; }\n  .q-head p { margin: 0; max-width: 56ch; }\n\n  /* ---------- Summary cards ---------- */\n  .q-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(16px * var(--space-scale, 1)); margin-top: calc(24px * var(--space-scale, 1)); }\n  .q-stat { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: calc(4px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) calc(20px * var(--space-scale, 1)); background: hsl(var(--card)); border: 1px solid hsl(var(--border)); border-radius: var(--card-radius, var(--radius)); box-shadow: var(--shadow); }\n  .q-stat .ds-stat-value { font-size: 34px; line-height: 1.05; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }\n  .q-stat-note { font-size: 13px; color: hsl(var(--muted-foreground)); }\n  .q-stat-total .ds-stat-value { color: hsl(var(--primary-text)); }\n  .q-stat-done { background: hsl(var(--success-soft)); border-color: hsl(var(--success) / 0.35); }\n  .q-stat-done .ds-stat-label, .q-stat-done .q-stat-note { color: hsl(var(--success-soft-foreground) / 0.85); }\n  .q-stat-done .ds-stat-value { color: hsl(var(--success-soft-foreground)); }\n  .q-stat-open .ds-stat-value { color: hsl(var(--foreground)); }\n  .q-stat-mark { position: absolute; right: calc(14px * var(--space-scale, 1)); top: calc(14px * var(--space-scale, 1)); width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; color: hsl(var(--success-soft-foreground)); background: hsl(var(--success) / 0.16); }\n\n  /* ---------- Add task card ---------- */\n  .q-add { margin-top: calc(16px * var(--space-scale, 1)); padding: calc(16px * var(--space-scale, 1)) calc(20px * var(--space-scale, 1)); background: hsl(var(--card)); border: 1px solid hsl(var(--border)); border-radius: var(--card-radius, var(--radius)); box-shadow: var(--shadow); }\n  .q-add-head { display: flex; align-items: baseline; gap: calc(8px * var(--space-scale, 1)); margin-bottom: calc(12px * var(--space-scale, 1)); }\n  .q-add-head h2 { margin: 0; }\n  .q-add-row { display: flex; flex-wrap: wrap; gap: calc(12px * var(--space-scale, 1)); align-items: flex-end; }\n  .q-add-title { flex: 1 1 240px; min-width: 0; }\n  .q-add-date { flex: 0 0 auto; width: 190px; }\n  .q-add-row .ds-label { font-size: 13px; }\n  .q-error-line { color: hsl(var(--danger, var(--destructive))); font-size: 13px; font-weight: 600; margin-top: calc(8px * var(--space-scale, 1)); }\n\n  /* ---------- Task list ---------- */\n  .q-list-head { display: flex; flex-wrap: wrap; align-items: center; gap: calc(12px * var(--space-scale, 1)); margin-top: calc(32px * var(--space-scale, 1)); margin-bottom: calc(12px * var(--space-scale, 1)); }\n  .q-clear { color: hsl(var(--danger, var(--destructive))); }\n  .q-tasks { display: flex; flex-direction: column; gap: calc(8px * var(--space-scale, 1)); }\n  .q-task { display: flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); padding: calc(12px * var(--space-scale, 1)) calc(14px * var(--space-scale, 1)); background: hsl(var(--card)); border: 1px solid hsl(var(--border)); border-radius: var(--card-radius, var(--radius)); box-shadow: var(--shadow); transition: background 0.15s ease, border-color 0.15s ease; }\n  .q-task-body { min-width: 0; flex: 1 1 auto; display: flex; flex-direction: column; gap: calc(4px * var(--space-scale, 1)); }\n  .q-task-title { font-size: 15px; font-weight: 600; color: hsl(var(--foreground)); word-break: break-word; }\n  .q-task-meta { display: flex; flex-wrap: wrap; align-items: center; gap: calc(8px * var(--space-scale, 1)); font-size: 13px; color: hsl(var(--muted-foreground)); }\n  .q-task-meta .q-date { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }\n  .q-task.is-done { background: hsl(var(--success-soft)); border-color: hsl(var(--success) / 0.4); }\n  .q-task.is-done .q-task-title { text-decoration: line-through; color: hsl(var(--success-soft-foreground) / 0.7); }\n  .q-check { flex: none; width: 28px; height: 44px; display: grid; place-items: center; background: none; border: 0; cursor: pointer; padding: 0; color: hsl(var(--muted-foreground)); }\n  .q-check span { width: 24px; height: 24px; border-radius: 50%; border: 2px solid hsl(var(--border)); background: hsl(var(--card)); display: grid; place-items: center; transition: background 0.15s ease, border-color 0.15s ease; }\n  .q-task.is-done .q-check span { background: hsl(var(--success)); border-color: hsl(var(--success)); color: hsl(var(--success-foreground, var(--background))); }\n  .q-check svg { width: 14px; height: 14px; opacity: 0; }\n  .q-task.is-done .q-check svg { opacity: 1; }\n  .q-row-actions { flex: none; display: flex; align-items: center; gap: calc(4px * var(--space-scale, 1)); }\n  .q-edit-fields { display: flex; flex-wrap: wrap; gap: calc(12px * var(--space-scale, 1)); }\n  .q-edit-fields .q-edit-title { flex: 1 1 220px; }\n  .q-edit-fields .q-edit-date { flex: 0 0 auto; width: 170px; }\n\n  /* ---------- Confirmation dialog (drawn closed) ---------- */\n  .q-confirm-note { font-size: 13px; color: hsl(var(--muted-foreground)); margin-top: calc(8px * var(--space-scale, 1)); }\n\n  /* ---------- Empty state ---------- */\n  .q-empty-wrap { margin-top: calc(32px * var(--space-scale, 1)); background: hsl(var(--card)); border: 1px solid hsl(var(--border)); border-radius: var(--card-radius, var(--radius)); box-shadow: var(--shadow); }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 900px) {\n    .q-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  }\n  @media (max-width: 760px) {\n    .q-stats { grid-template-columns: 1fr; }\n    .q-add-date { width: 100%; }\n    .q-add-row .ds-btn { width: 100%; }\n    .q-task { flex-wrap: wrap; }\n    .q-task-body { flex-basis: calc(100% - 28px - 12px - 44px); }\n    .q-row-actions { margin-left: auto; }\n  }\n</style><main data-screen=\"home\" data-eid=\"e1\">\n  <div class=\"ds-shell\" data-eid=\"e2\">\n    <div data-part=\"sidebar\" data-eid=\"e3\"></div>\n    <div class=\"ds-shell-main\" data-eid=\"e4\">\n      <div data-part=\"header\" data-eid=\"e5\"></div>\n\n      <div data-eid=\"content\">\n      <div class=\"ds-page q-page\" data-eid=\"e6\">\n        <div class=\"ds-page-head q-head\" data-eid=\"e7\">\n          <div data-eid=\"e8\">\n            <h1 class=\"ds-h1\" data-eid=\"e9\">Your tasks</h1>\n            <p class=\"ds-muted\" data-eid=\"e10\">Everything on your list, with what is done and what is still waiting.</p>\n          </div>\n          <div class=\"ds-actions\" data-eid=\"e11\">\n            <a class=\"ds-btn\" href=\"#\" aria-label=\"Add a task\" data-eid=\"e12\">\n              <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"></path></svg>\n              Add Task\n            </a>\n          </div>\n        </div>\n\n        <div class=\"q-stats\" data-eid=\"e13\">\n          <div class=\"ds-stat q-stat q-stat-total\" data-eid=\"e14\">\n            <span class=\"ds-stat-label\" data-eid=\"e15\">Total tasks</span>\n            <span class=\"ds-stat-value\" data-sample=\"\" data-eid=\"e16\">5</span>\n            <span class=\"q-stat-note\" data-eid=\"e17\">On your list right now</span>\n          </div>\n          <div class=\"ds-stat q-stat q-stat-done\" data-eid=\"e18\">\n            <span class=\"ds-stat-label\" data-eid=\"e19\">Completed</span>\n            <span class=\"ds-stat-value\" data-sample=\"\" data-eid=\"e20\">2</span>\n            <span class=\"q-stat-note\" data-eid=\"e21\">Ticked off and finished</span>\n            <span class=\"q-stat-mark\" aria-hidden=\"true\" data-eid=\"e22\">\n              <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m5 12 4.5 4.5L19 7\"></path></svg>\n            </span>\n          </div>\n          <div class=\"ds-stat q-stat q-stat-open\" data-eid=\"e23\">\n            <span class=\"ds-stat-label\" data-eid=\"e24\">Pending</span>\n            <span class=\"ds-stat-value\" data-sample=\"\" data-eid=\"e25\">3</span>\n            <span class=\"q-stat-note\" data-eid=\"e26\">Still to do</span>\n          </div>\n        </div>\n\n        <div class=\"ds-card q-add\" id=\"add\" data-eid=\"e27\">\n          <div class=\"q-add-head\" data-eid=\"e28\">\n            <h2 class=\"ds-h3\" data-eid=\"e29\">Add New Task</h2>\n          </div>\n          <form class=\"q-add-row\" data-eid=\"e30\">\n            <div class=\"ds-field q-add-title\" data-eid=\"e31\">\n              <label class=\"ds-label\" for=\"new-task\" data-eid=\"e32\">Task</label>\n              <input class=\"ds-input\" id=\"new-task\" type=\"text\" maxlength=\"200\" placeholder=\"Enter your task...\" data-eid=\"e33\">\n            </div>\n            <div class=\"ds-field q-add-date\" data-eid=\"e34\">\n              <label class=\"ds-label\" for=\"new-date\" data-eid=\"e35\">Due date</label>\n              <input class=\"ds-input\" id=\"new-date\" type=\"date\" value=\"2026-11-12\" data-sample=\"Task#new.dueDate\" data-eid=\"e36\">\n            </div>\n            <div class=\"ds-form-actions\" style=\"margin:0\" data-eid=\"e37\">\n              <button class=\"ds-btn\" type=\"submit\" data-situation=\"done\" data-eid=\"e38\">Add Task</button>\n            </div>\n          </form>\n          <p class=\"q-error-line\" data-over=\"\" hidden=\"\" style=\"display:none\" aria-live=\"polite\" data-eid=\"e39\"></p>\n        </div>\n\n        <div class=\"q-list-head\" data-eid=\"e40\">\n          <div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Filter tasks\" data-eid=\"e41\">\n            <button class=\"ds-tab ds-active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-all\" id=\"tab-all\" data-eid=\"e42\">All <span data-sample=\"\" data-eid=\"e43\">5</span></button>\n            <button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-pending\" id=\"tab-pending\" data-eid=\"e44\">Pending <span data-sample=\"\" data-eid=\"e45\">3</span></button>\n            <button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-completed\" id=\"tab-completed\" data-eid=\"e46\">Completed <span data-sample=\"\" data-eid=\"e47\">2</span></button>\n          </div>\n          <span class=\"ds-spacer\" data-eid=\"e48\"></span>\n          <details class=\"ds-menu\">\n            <summary class=\"ds-btn ds-btn-secondary\" aria-label=\"More task list actions\">\n              <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n              More\n            </summary>\n            <div class=\"ds-menu-list\" data-eid=\"e49\">\n              <button class=\"q-clear\" type=\"button\" data-eid=\"e50\">Clear All</button>\n            </div>\n          </details>\n        </div>\n\n        <div id=\"panel-all\" role=\"tabpanel\" aria-labelledby=\"tab-all\" data-eid=\"e51\">\n          <div class=\"q-tasks\" data-eid=\"e52\">\n            <div class=\"q-task is-done\" data-eid=\"e53\">\n              <button class=\"q-check\" type=\"button\" aria-pressed=\"true\" aria-label=\"Mark Finish project report as pending\" data-eid=\"e54\">\n                <span data-eid=\"e55\">\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"></path></svg>\n                </span>\n              </button>\n              <div class=\"q-task-body\" data-eid=\"e56\">\n                <span class=\"q-task-title\" data-sample=\"Task#1.title\" data-eid=\"e57\">Finish project report</span>\n                <div class=\"q-task-meta\" data-eid=\"e58\">\n                  <span class=\"q-date\" data-sample=\"Task#1.dueDate\" data-eid=\"e59\">\n                    <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"></rect><path d=\"M3 10h18M8 3v4M16 3v4\"></path></svg>\n                    7 Nov\n                  </span>\n                  <span class=\"ds-badge ds-badge-success\" data-eid=\"e60\">Completed</span>\n                </div>\n              </div>\n              <div class=\"ds-row-actions q-row-actions\" data-eid=\"e61\">\n                <button class=\"ds-btn ds-btn-ghost ds-btn-sm q-hide-sm\" type=\"button\" aria-label=\"Edit Finish project report\" data-eid=\"e62\">\n                  <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 20h9\"></path><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"></path></svg>\n                  Edit\n                </button>\n                <button class=\"ds-btn ds-btn-ghost ds-btn-icon\" type=\"button\" aria-label=\"Delete Finish project report\" data-eid=\"e63\">\n                  <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14\"></path></svg>\n                </button>\n                <details class=\"ds-menu\">\n                  <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"More actions for Finish project report\">\n                    <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n                  </summary>\n                  <div class=\"ds-menu-list\" data-eid=\"e64\">\n                    <button type=\"button\" data-eid=\"e65\">Edit task</button>\n                    <button type=\"button\" class=\"q-clear\" data-eid=\"e66\">Delete task</button>\n                  </div>\n                </details>\n              </div>\n            </div>\n\n            <div class=\"q-task\" data-eid=\"e67\">\n              <button class=\"q-check\" type=\"button\" aria-pressed=\"false\" aria-label=\"Mark Read a book as completed\" data-eid=\"e68\">\n                <span data-eid=\"e69\">\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"></path></svg>\n                </span>\n              </button>\n              <div class=\"q-task-body\" data-eid=\"e70\">\n                <span class=\"q-task-title\" data-sample=\"Task#2.title\" data-eid=\"e71\">Read a book</span>\n                <div class=\"q-task-meta\" data-eid=\"e72\">\n                  <span class=\"q-date\" data-sample=\"Task#2.dueDate\" data-eid=\"e73\">\n                    <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"></rect><path d=\"M3 10h18M8 3v4M16 3v4\"></path></svg>\n                    Today\n                  </span>\n                  <span class=\"ds-badge ds-badge-info\" data-eid=\"e74\">Pending</span>\n                </div>\n              </div>\n              <div class=\"ds-row-actions q-row-actions\" data-eid=\"e75\">\n                <button class=\"ds-btn ds-btn-ghost ds-btn-sm\" type=\"button\" aria-label=\"Edit Read a book\" data-eid=\"e76\">\n                  <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 20h9\"></path><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"></path></svg>\n                  Edit\n                </button>\n                <button class=\"ds-btn ds-btn-ghost ds-btn-icon\" type=\"button\" aria-label=\"Delete Read a book\" data-eid=\"e77\">\n                  <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14\"></path></svg>\n                </button>\n                <details class=\"ds-menu\">\n                  <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"More actions for Read a book\">\n                    <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n                  </summary>\n                  <div class=\"ds-menu-list\" data-eid=\"e78\">\n                    <button type=\"button\" data-eid=\"e79\">Edit task</button>\n                    <button type=\"button\" class=\"q-clear\" data-eid=\"e80\">Delete task</button>\n                  </div>\n                </details>\n              </div>\n            </div>\n\n            <div class=\"q-task\" data-eid=\"e81\">\n              <button class=\"q-check\" type=\"button\" aria-pressed=\"false\" aria-label=\"Mark Go for a walk as completed\" data-eid=\"e82\">\n                <span data-eid=\"e83\">\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"></path></svg>\n                </span>\n              </button>\n              <div class=\"q-task-body\" data-eid=\"e84\">\n                <span class=\"q-task-title\" data-sample=\"Task#3.title\" data-eid=\"e85\">Go for a walk</span>\n                <div class=\"q-task-meta\" data-eid=\"e86\">\n                  <span class=\"q-date\" data-sample=\"Task#3.dueDate\" data-eid=\"e87\">\n                    <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"></rect><path d=\"M3 10h18M8 3v4M16 3v4\"></path></svg>\n                    Tomorrow\n                  </span>\n                  <span class=\"ds-badge ds-badge-info\" data-eid=\"e88\">Pending</span>\n                </div>\n              </div>\n              <div class=\"ds-row-actions q-row-actions\" data-eid=\"e89\">\n                <button class=\"ds-btn ds-btn-ghost ds-btn-sm\" type=\"button\" aria-label=\"Edit Go for a walk\" data-eid=\"e90\">\n                  <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 20h9\"></path><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"></path></svg>\n                  Edit\n                </button>\n                <button class=\"ds-btn ds-btn-ghost ds-btn-icon\" type=\"button\" aria-label=\"Delete Go for a walk\" data-eid=\"e91\">\n                  <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14\"></path></svg>\n                </button>\n                <details class=\"ds-menu\">\n                  <summary class=\"ds-btn ds-btn-ghost ds-btn-icon\" aria-label=\"More actions for Go for a walk\">\n                    <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.5\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.5\"></circle></svg>\n                  </summary>\n                  <div class=\"ds-menu-list\" data-eid=\"e92\">\n                    <button type=\"button\" data-eid=\"e93\">Edit task</button>\n                    <button type=\"button\" class=\"q-clear\" data-eid=\"e94\">Delete task</button>\n                  </div>\n                </details>\n              </div>\n            </div>\n\n            <div class=\"q-task\" data-eid=\"e95\">\n              <button class=\"q-check\" type=\"button\" aria-pressed=\"false\" aria-label=\"Mark Renew car insurance as completed\" data-eid=\"e96\">\n                <span data-eid=\"e97\">\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m5 12 4.5 4.5L19 7\"></path></svg>\n                </span>\n              </button>\n              <div class=\"q-task-body\" data-eid=\"e98\">\n                <span class=\"q-task-title\" data-sample=\"Task#4.title\" data-eid=\"e99\">Renew car insurance before the weekend and send the new certificate to Priya</span>\n                <div class=\"q-task-meta\" data-eid=\"e100\">\n                  <span class=\"q-date\" data-sample=\"Task#4.dueDate\" data-eid=\"e101\">\n                    <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"></rect><path d=\"M3 10h18M8 3v4M16 3v4\"></path></svg>\n                    18 Nov\n                  </span>\n                  <span class=\"ds-badge ds-badge-info\" data-eid