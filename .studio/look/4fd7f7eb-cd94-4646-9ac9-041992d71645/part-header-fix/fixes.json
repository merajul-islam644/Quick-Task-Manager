{"html":"<style>\n  .qs-top { background: hsl(var(--card)); border-bottom: 1px solid hsl(var(--border)); }\n  .qs-top-bar { display: flex; align-items: center; gap: calc(16px * var(--space-scale, 1)); padding-top: 12px; padding-bottom: 12px; }\n  .qs-top-nowrap { display: flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); flex: none; }\n  .qs-top-trail { display: flex; align-items: center; gap: calc(12px * var(--space-scale, 1)); }\n  .qs-top .ds-brand-link { display: inline-flex; align-items: center; }\n  .qs-menu-theme { padding: 8px 4px 4px; display: flex; justify-content: flex-start; }\n  .qs-menu-signout { display: none; }\n  @media (max-width: 760px) {\n    .qs-top-bar { gap: calc(8px * var(--space-scale, 1)); }\n    .qs-menu-signout { display: block; }\n  }\n</style>\n<header class=\"qs-top\" data-eid=\"e1\">\n  <div class=\"ds-bar qs-top-bar\" data-eid=\"e2\">\n    <details class=\"ds-menu ds-menu-left ds-only-narrow\">\n      <summary class=\"ds-menu-button\" aria-label=\"Open the menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></summary>\n      <div class=\"ds-menu-list\" data-eid=\"e3\">\n        <a data-goto=\"home\" data-eid=\"e4\">Home</a>\n        <a data-goto=\"statistics\" data-eid=\"e5\">Statistics</a>\n        <a data-goto=\"settings\" data-eid=\"e6\">Settings</a>\n        <a class=\"qs-menu-signout\" data-goto=\"welcome\" data-eid=\"e7\">Sign out</a>\n        <div class=\"qs-menu-theme\" data-eid=\"e8\">\n          <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e9\">\n            <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e10\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4\"></path></svg></button>\n            <button aria-label=\"Dark\" data-eid=\"e11\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n            <button aria-label=\"Auto\" data-eid=\"e12\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n          </div>\n        </div>\n      </div>\n    </details>\n\n    <div class=\"qs-top-nowrap\" data-eid=\"e13\">\n      <a class=\"ds-brand-link ds-only-narrow\" data-goto=\"home\" data-eid=\"e14\"><img class=\"ds-brand ds-brand-light\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/4db7d9fa-5751-4d03-a387-a03389ae8786/66bc4fc6-9829-4297-b579-36b98cd4b1c2/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e15\"><img class=\"ds-brand ds-brand-dark\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/f2f6488c-a0c3-4e6a-9786-e726fff29e15/106500fc-0028-44d1-a371-c9fae6669afd/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e16\"></a>\n    </div>\n\n    <span class=\"ds-spacer\" data-eid=\"e17\"></span>\n\n    <div class=\"qs-top-trail\" data-eid=\"e18\">\n      <div class=\"ds-theme-switch ds-only-wide\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e19\">\n        <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e20\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4\"></path></svg></button>\n        <button aria-label=\"Dark\" data-eid=\"e21\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n        <button aria-label=\"Auto\" data-eid=\"e22\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n      </div>\n    </div>\n  </div>\n</header>","changes":[]}