{"html":"<style>\n  .qs-side { display: flex; flex-direction: column; gap: 0; height: 100%; padding: 24px 16px 16px; }\n  .qs-side-brand { padding: 0 8px 24px; }\n  .qs-side-nav { display: flex; flex-direction: column; gap: 4px; }\n  .qs-side-nav .ds-nav-item { min-height: 44px; }\n  .qs-side-art { margin-top: auto; padding: 24px 8px 16px; }\n  .qs-side-art-box { position: relative; overflow: hidden; border-radius: var(--radius); background: linear-gradient(160deg, hsl(var(--primary) / 0.10), hsl(var(--accent) / 0.16)); padding: 16px; }\n  .qs-side-art svg { display: block; width: 100%; height: auto; }\n  .qs-side-art-line { margin: 12px 0 0; font-family: var(--font-heading); font-size: 13px; font-weight: 600; letter-spacing: 0.04em; color: hsl(var(--primary-text)); }\n  .qs-side-person { border-top: 1px solid hsl(var(--border)); padding: 16px 8px 0; margin-top: 16px; }\n  .qs-side-signout { margin-top: 12px; width: 100%; justify-content: flex-start; }\n</style>\n<aside class=\"qs-side\" aria-label=\"Quick Task Manager\" data-eid=\"e1\">\n  <div class=\"qs-side-brand\" data-eid=\"e2\">\n    <a class=\"ds-brand-link\" data-goto=\"home\" data-eid=\"e3\"><img class=\"ds-brand ds-brand-light\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/4db7d9fa-5751-4d03-a387-a03389ae8786/66bc4fc6-9829-4297-b579-36b98cd4b1c2/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e4\"><img class=\"ds-brand ds-brand-dark\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/f2f6488c-a0c3-4e6a-9786-e726fff29e15/106500fc-0028-44d1-a371-c9fae6669afd/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e5\"></a>\n  </div>\n  <nav class=\"ds-nav qs-side-nav\" aria-label=\"Main\" data-eid=\"e6\">\n    <a class=\"ds-nav-item ds-active\" data-goto=\"home\" data-eid=\"e7\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M3 10.5 12 3l9 7.5\"></path><path d=\"M5 9.5V21h14V9.5\"></path><path d=\"M10 21v-6h4v6\"></path></svg>Home</a>\n    <a class=\"ds-nav-item\" data-goto=\"statistics\" data-eid=\"e8\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"></path></svg>Statistics</a>\n    <a class=\"ds-nav-item\" data-goto=\"settings\" data-eid=\"e9\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"3.25\"></circle><path d=\"M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15 4.6a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9v.09a1.7 1.7 0 0 0 1.55 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1Z\"></path></svg>Settings</a>\n  </nav>\n  <div class=\"qs-side-art\" aria-hidden=\"true\" data-eid=\"e10\">\n    <div class=\"qs-side-art-box\" data-eid=\"e11\">\n      <div class=\"ds-deco\" style=\"top:-32px;right:-24px;width:96px;height:96px;border-radius:50%;background:hsl(var(--primary) / 0.14)\" data-eid=\"e12\"></div>\n      <svg viewBox=\"0 0 120 84\" fill=\"none\">\n        <rect x=\"14\" y=\"6\" width=\"72\" height=\"20\" rx=\"6\" fill=\"hsl(var(--card))\" stroke=\"hsl(var(--border))\"></rect>\n        <circle cx=\"26\" cy=\"16\" r=\"5\" fill=\"hsl(var(--success) / 0.18)\" stroke=\"hsl(var(--success))\" stroke-width=\"1.5\"></circle>\n        <path d=\"m23.5 16 1.8 1.9 3.2-3.6\" stroke=\"hsl(var(--success))\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n        <rect x=\"38\" y=\"12\" width=\"40\" height=\"3\" rx=\"1.5\" fill=\"hsl(var(--muted-foreground) / 0.55)\"></rect>\n        <rect x=\"38\" y=\"19\" width=\"24\" height=\"3\" rx=\"1.5\" fill=\"hsl(var(--muted))\"></rect>\n        <rect x=\"24\" y=\"34\" width=\"72\" height=\"20\" rx=\"6\" fill=\"hsl(var(--card))\" stroke=\"hsl(var(--border))\"></rect>\n        <circle cx=\"36\" cy=\"44\" r=\"5\" fill=\"hsl(var(--card))\" stroke=\"hsl(var(--primary))\" stroke-width=\"1.5\"></circle>\n        <rect x=\"48\" y=\"40\" width=\"40\" height=\"3\" rx=\"1.5\" fill=\"hsl(var(--muted-foreground) / 0.55)\"></rect>\n        <rect x=\"48\" y=\"47\" width=\"20\" height=\"3\" rx=\"1.5\" fill=\"hsl(var(--primary) / 0.45)\"></rect>\n        <rect x=\"8\" y=\"62\" width=\"72\" height=\"20\" rx=\"6\" fill=\"hsl(var(--card))\" stroke=\"hsl(var(--border))\"></rect>\n        <circle cx=\"20\" cy=\"72\" r=\"5\" fill=\"hsl(var(--card))\" stroke=\"hsl(var(--primary))\" stroke-width=\"1.5\"></circle>\n        <rect x=\"32\" y=\"68\" width=\"34\" height=\"3\" rx=\"1.5\" fill=\"hsl(var(--muted-foreground) / 0.55)\"></rect>\n        <rect x=\"32\" y=\"75\" width=\"16\" height=\"3\" rx=\"1.5\" fill=\"hsl(var(--muted))\"></rect>\n      </svg>\n      <p class=\"qs-side-art-line\" data-eid=\"e13\">Plan. Focus. Achieve.</p>\n    </div>\n  </div>\n  <div class=\"qs-side-person\" data-eid=\"e14\">\n    <div class=\"ds-user\" data-eid=\"e15\">\n      <span class=\"ds-avatar\" data-sample=\"\" data-eid=\"e16\">PS</span>\n      <span class=\"ds-user-text\" data-eid=\"e17\">\n        <b class=\"ds-user-name\" data-sample=\"me.name\">Priya Shah</b>\n        <span class=\"ds-user-role\" data-sample=\"me.role\" data-eid=\"e18\">Task owner</span>\n      </span>\n    </div>\n    <a class=\"ds-btn ds-btn-ghost ds-btn-sm qs-side-signout\" data-goto=\"welcome\" data-eid=\"e19\">Sign out</a>\n  </div>\n</aside>","changes":[]}