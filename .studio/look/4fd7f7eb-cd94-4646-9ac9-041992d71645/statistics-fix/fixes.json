{"html":"<style>\n  .st-head {\n    background: linear-gradient(180deg, hsl(var(--primary) / 0.07), transparent 90%);\n    border-bottom: 1px solid hsl(var(--border));\n  }\n  .st-bar {\n    display: flex;\n    align-items: center;\n    gap: calc(12px * var(--space-scale, 1));\n    padding-top: calc(16px * var(--space-scale, 1));\n    padding-bottom: calc(16px * var(--space-scale, 1));\n  }\n  .st-page-head {\n    padding-top: calc(24px * var(--space-scale, 1));\n    padding-bottom: calc(32px * var(--space-scale, 1));\n  }\n  .st-eyebrow { margin-bottom: calc(8px * var(--space-scale, 1)); display: inline-block; }\n  .st-sub { margin: calc(6px * var(--space-scale, 1)) 0 0; }\n  .st-figures {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: calc(16px * var(--space-scale, 1));\n  }\n  .st-figure {\n    position: relative;\n    padding: calc(24px * var(--space-scale, 1));\n    display: flex;\n    flex-direction: column;\n    gap: calc(8px * var(--space-scale, 1));\n    background: hsl(var(--card));\n    border: 1px solid hsl(var(--border));\n    border-radius: var(--card-radius, var(--radius));\n    box-shadow: var(--shadow);\n    overflow: visible;\n  }\n  .st-figure-key {\n    background: linear-gradient(160deg, hsl(var(--primary)), hsl(var(--primary) / 0.82));\n    border-color: hsl(var(--primary));\n    color: hsl(var(--primary-foreground));\n  }\n  .st-figure-key .ds-stat-label,\n  .st-figure-key .st-note { color: hsl(var(--primary-foreground) / 0.82); }\n  .st-figure-done { border-top: 3px solid hsl(var(--success)); }\n  .st-figure-pending { border-top: 3px solid hsl(var(--primary)); }\n  .st-big {\n    font-family: var(--font-heading);\n    font-size: clamp(40px, 6vw, 56px);\n    line-height: 1;\n    letter-spacing: -0.035em;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n  }\n  .st-note { font-size: 13px; }\n  .st-share {\n    margin-top: calc(32px * var(--space-scale, 1));\n    padding: calc(24px * var(--space-scale, 1));\n    background: hsl(var(--card));\n    border: 1px solid hsl(var(--border));\n    border-radius: var(--card-radius, var(--radius));\n    box-shadow: var(--shadow);\n  }\n  .st-share-top {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: calc(16px * var(--space-scale, 1));\n    margin-bottom: calc(16px * var(--space-scale, 1));\n  }\n  .st-share-line {\n    font-family: var(--font-heading);\n    font-size: 20px;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n    margin: 0;\n  }\n  .st-share-pct {\n    font-family: var(--font-heading);\n    font-size: 32px;\n    font-weight: 700;\n    letter-spacing: -0.03em;\n    line-height: 1;\n    color: hsl(var(--success));\n    font-variant-numeric: tabular-nums;\n    white-space: nowrap;\n  }\n  .st-share .ds-progress { height: 12px; }\n  .st-share .ds-progress span { background: hsl(var(--success)); }\n  .st-legend {\n    display: flex;\n    flex-wrap: wrap;\n    gap: calc(24px * var(--space-scale, 1));\n    margin-top: calc(16px * var(--space-scale, 1));\n  }\n  .st-key { display: flex; align-items: center; gap: calc(8px * var(--space-scale, 1)); font-size: 14px; }\n  .st-dot { width: 10px; height: 10px; border-radius: 2px; flex: none; }\n  .st-dot-done { background: hsl(var(--success)); }\n  .st-dot-open { background: hsl(var(--muted-foreground) / 0.35); }\n  .st-foot {\n    margin-top: calc(32px * var(--space-scale, 1));\n    padding-top: calc(16px * var(--space-scale, 1));\n    border-top: 1px solid hsl(var(--border));\n    display: flex;\n    align-items: center;\n    gap: calc(12px * var(--space-scale, 1));\n    flex-wrap: wrap;\n  }\n  .st-empty-wrap { padding-top: calc(16px * var(--space-scale, 1)); }\n  @media (max-width: 860px) {\n    .st-figures { grid-template-columns: 1fr; }\n  }\n  @media (max-width: 560px) {\n    .st-share-top { flex-direction: column; align-items: flex-start; gap: calc(8px * var(--space-scale, 1)); }\n  }\n</style><main data-screen=\"statistics\" data-eid=\"e1\">\n  <div class=\"ds-shell\" data-eid=\"e2\">\n    <div data-part=\"sidebar\" data-eid=\"e3\"></div>\n    <div class=\"ds-shell-main\" data-eid=\"e4\">\n      <div data-part=\"header\" data-eid=\"e5\"></div>\n\n      <div data-eid=\"content\">\n        <div class=\"st-head\" data-eid=\"e6\">\n          <div class=\"ds-page\" data-eid=\"e7\">\n            <div class=\"ds-page-head st-page-head\" data-eid=\"e8\">\n              <div data-eid=\"e9\">\n                <span class=\"ds-eyebrow st-eyebrow\" data-eid=\"e10\">Overview</span>\n                <h1 class=\"ds-h1\" data-eid=\"e11\">Statistics</h1>\n                <p class=\"ds-muted st-sub\" data-eid=\"e12\">Live counts for your own tasks, worked out from your list the moment you open this screen.</p>\n              </div>\n              <div class=\"ds-actions\" data-eid=\"e13\">\n                <a class=\"ds-btn ds-btn-secondary\" data-goto=\"home\" data-eid=\"e14\">Go to Home</a>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ds-page\" data-eid=\"figures\">\n          <section class=\"ds-section\" style=\"margin-top: calc(32px * var(--space-scale, 1))\" data-eid=\"e15\">\n            <div class=\"st-figures\" data-eid=\"e16\">\n              <div class=\"st-figure st-figure-key\" data-eid=\"e17\">\n                <span class=\"ds-stat-label\" data-eid=\"e18\">Total tasks</span>\n                <span class=\"st-big\" data-sample=\"\" data-eid=\"e19\">5</span>\n                <span class=\"st-note\" data-eid=\"e20\">Every task on your list</span>\n              </div>\n              <div class=\"st-figure st-figure-done\" data-eid=\"e21\">\n                <span class=\"ds-stat-label\" data-eid=\"e22\">Completed</span>\n                <span class=\"st-big\" data-sample=\"\" data-eid=\"e23\">2</span>\n                <span class=\"ds-note ds-muted\" data-eid=\"e24\">Checked off so far</span>\n              </div>\n              <div class=\"st-figure st-figure-pending\" data-eid=\"e25\">\n                <span class=\"ds-stat-label\" data-eid=\"e26\">Pending</span>\n                <span class=\"st-big\" data-sample=\"\" data-eid=\"e27\">3</span>\n                <span class=\"ds-note ds-muted\" data-eid=\"e28\">Still waiting for you</span>\n              </div>\n            </div>\n          </section>\n\n          <section class=\"ds-section\" data-eid=\"e29\">\n            <div class=\"st-share\" data-eid=\"e30\">\n              <div class=\"st-share-top\" data-eid=\"e31\">\n                <div data-eid=\"e32\">\n                  <span class=\"ds-label-caps\" data-eid=\"e33\">Completed share</span>\n                  <p class=\"st-share-line\" data-sample=\"\" data-eid=\"e34\">2 of 5 tasks done</p>\n                </div>\n                <span class=\"st-share-pct\" data-sample=\"\" data-eid=\"e35\">40%</span>\n              </div>\n              <div class=\"ds-progress\" data-eid=\"e36\"><span style=\"width: 40%\" data-eid=\"e37\"></span></div>\n              <div class=\"st-legend\" data-eid=\"e38\">\n                <span class=\"st-key\" data-eid=\"e39\"><span class=\"st-dot st-dot-done\" data-eid=\"e40\"></span><span class=\"ds-muted\" data-eid=\"e41\">Done</span></span>\n                <span class=\"st-key\" data-eid=\"e42\"><span class=\"st-dot st-dot-open\" data-eid=\"e43\"></span><span class=\"ds-muted\" data-eid=\"e44\">Pending</span></span>\n              </div>\n            </div>\n          </section>\n\n          <div class=\"st-foot\" data-eid=\"e45\">\n            <span class=\"ds-muted\" data-eid=\"e46\">Mark a task done on Home and these numbers change with it.</span>\n            <span class=\"ds-spacer\" data-eid=\"e47\"></span>\n            <a class=\"ds-btn ds-btn-ghost\" data-goto=\"home\" data-eid=\"e48\">Back to my tasks</a>\n          </div>\n        </div>\n      </div>\n\n      <section data-state=\"empty\" data-replaces=\"content\" hidden=\"\" data-eid=\"e49\">\n        <div class=\"st-head\" data-eid=\"e50\">\n          <div class=\"ds-page\" data-eid=\"e51\">\n            <div class=\"ds-page-head st-page-head\" data-eid=\"e52\">\n              <div data-eid=\"e53\">\n                <span class=\"ds-eyebrow st-eyebrow\" data-eid=\"e54\">Overview</span>\n                <h1 class=\"ds-h1\" data-eid=\"e55\">Statistics</h1>\n                <p class=\"ds-muted st-sub\" data-eid=\"e56\">Live counts for your own tasks, worked out from your list the moment you open this screen.</p>\n              </div>\n              <div class=\"ds-actions\" data-eid=\"e57\">\n                <a class=\"ds-btn ds-btn-secondary\" data-goto=\"home\" data-eid=\"e58\">Go to Home</a>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"ds-page st-empty-wrap\" data-eid=\"e59\">\n          <div class=\"ds-card\" data-eid=\"e60\">\n            <div class=\"ds-empty\" data-eid=\"e61\">\n              <span class=\"ds-empty-icon\" data-eid=\"e62\">\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"></path></svg>\n              </span>\n              <b style=\"color: hsl(var(--foreground))\">No tasks here. Add a task to get started!</b>\n              <span data-eid=\"e63\">Add your first task on Home and your numbers appear here.</span>\n              <a class=\"ds-btn\" style=\"margin-top: calc(8px * var(--space-scale, 1))\" data-goto=\"home\" data-eid=\"e64\">Go to Home</a>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  </div>\n</main>","changes":[]}