{"html":"<style>\n  [data-screen=\"welcome\"] {\n    background: hsl(var(--background));\n    color: hsl(var(--foreground));\n    font-family: var(--font-sans);\n    min-height: 100vh;\n  }\n\n  /* top row */\n  .wl-top {\n    border-bottom: 1px solid hsl(var(--border));\n    background: hsl(var(--card));\n  }\n  .wl-top-bar {\n    display: flex;\n    align-items: center;\n    gap: calc(16px * var(--space-scale, 1));\n    padding-top: calc(14px * var(--space-scale, 1));\n    padding-bottom: calc(14px * var(--space-scale, 1));\n  }\n  .wl-top-bar .ds-brand-link { display: inline-flex; align-items: center; }\n  .wl-top-right {\n    margin-left: auto;\n    display: flex;\n    align-items: center;\n    gap: calc(12px * var(--space-scale, 1));\n  }\n\n  /* hero band */\n  .wl-hero {\n    position: relative;\n    overflow: visible;\n    border-bottom: 1px solid hsl(var(--border));\n    background:\n      radial-gradient(120% 90% at 88% -10%, hsl(var(--primary) / 0.14), transparent 60%),\n      radial-gradient(80% 70% at 4% 110%, hsl(var(--accent) / 0.18), transparent 65%),\n      linear-gradient(180deg, hsl(var(--card)), hsl(var(--background)));\n  }\n  .wl-hero .ds-page {\n    padding-top: calc(64px * var(--space-scale, 1));\n    padding-bottom: calc(64px * var(--space-scale, 1));\n  }\n  .wl-hero-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);\n    gap: calc(48px * var(--space-scale, 1));\n    align-items: center;\n  }\n  .wl-promise {\n    font-family: var(--font-heading);\n    font-weight: 800;\n    letter-spacing: -0.035em;\n    line-height: 0.98;\n    font-size: clamp(44px, 7.2vw, 84px);\n    margin: calc(12px * var(--space-scale, 1)) 0 0;\n    color: hsl(var(--foreground));\n  }\n  .wl-promise .wl-word-accent {\n    display: block;\n    color: hsl(var(--primary-text));\n  }\n  .wl-lede {\n    font-size: 17px;\n    line-height: 1.55;\n    max-width: 44ch;\n    margin: calc(24px * var(--space-scale, 1)) 0 0;\n    color: hsl(var(--muted-foreground));\n  }\n  .wl-actions {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: calc(16px * var(--space-scale, 1));\n    margin-top: calc(32px * var(--space-scale, 1));\n  }\n  .wl-note {\n    display: inline-flex;\n    align-items: center;\n    gap: calc(8px * var(--space-scale, 1));\n    font-size: 14px;\n    color: hsl(var(--muted-foreground));\n  }\n  .wl-note svg { width: 18px; height: 18px; flex: none; }\n\n  /* preview of the list */\n  .wl-preview-wrap {\n    position: relative;\n    padding: calc(16px * var(--space-scale, 1));\n  }\n  .wl-preview {\n    position: relative;\n    border: 1px solid hsl(var(--border));\n    border-radius: var(--card-radius);\n    background: hsl(var(--card));\n    box-shadow: 0 24px 48px -24px hsl(var(--primary) / 0.35), var(--shadow);\n    padding: calc(24px * var(--space-scale, 1));\n  }\n  .wl-preview-head {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: calc(12px * var(--space-scale, 1));\n    padding-bottom: calc(16px * var(--space-scale, 1));\n    border-bottom: 1px solid hsl(var(--border));\n  }\n  .wl-preview-title {\n    font-family: var(--font-heading);\n    font-weight: 700;\n    font-size: 16px;\n    letter-spacing: -0.01em;\n    color: hsl(var(--foreground));\n  }\n  .wl-preview-count {\n    font-size: 13px;\n    color: hsl(var(--muted-foreground));\n    font-variant-numeric: tabular-nums;\n    white-space: nowrap;\n  }\n  .wl-tasks {\n    display: flex;\n    flex-direction: column;\n    gap: calc(12px * var(--space-scale, 1));\n    margin-top: calc(16px * var(--space-scale, 1));\n  }\n  .wl-task {\n    display: grid;\n    grid-template-columns: 24px minmax(0, 1fr) auto;\n    align-items: center;\n    gap: calc(12px * var(--space-scale, 1));\n    padding: calc(12px * var(--space-scale, 1));\n    border: 1px solid hsl(var(--border));\n    border-radius: var(--radius);\n    background: hsl(var(--background));\n  }\n  .wl-task.is-done {\n    border-color: hsl(var(--success) / 0.45);\n    background: hsl(var(--success-soft));\n  }\n  .wl-box {\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    border: 2px solid hsl(var(--muted-foreground) / 0.5);\n    display: grid;\n    place-items: center;\n    color: transparent;\n    flex: none;\n  }\n  .wl-task.is-done .wl-box {\n    border-color: hsl(var(--success));\n    background: hsl(var(--success));\n    color: hsl(var(--success-foreground));\n  }\n  .wl-box svg { width: 14px; height: 14px; }\n  .wl-task-text { min-width: 0; }\n  .wl-task-title {\n    display: block;\n    font-size: 15px;\n    font-weight: 600;\n    color: hsl(var(--foreground));\n    overflow-wrap: anywhere;\n  }\n  .wl-task.is-done .wl-task-title {\n    text-decoration: line-through;\n    color: hsl(var(--muted-foreground));\n    font-weight: 500;\n  }\n  .wl-task-sub {\n    display: flex;\n    align-items: center;\n    gap: calc(8px * var(--space-scale, 1));\n    margin-top: calc(4px * var(--space-scale, 1));\n    flex-wrap: wrap;\n  }\n  .wl-task-date {\n    font-size: 13px;\n    color: hsl(var(--muted-foreground));\n    white-space: nowrap;\n  }\n  .wl-trash {\n    width: 32px;\n    height: 32px;\n    display: grid;\n    place-items: center;\n    border: 0;\n    background: none;\n    border-radius: var(--radius);\n    color: hsl(var(--muted-foreground));\n    padding: calc(6px * var(--space-scale, 1));\n  }\n  .wl-trash svg { width: 16px; height: 16px; }\n\n  .wl-tag {\n    position: relative;\n    z-index: 1;\n    display: inline-flex;\n    align-items: center;\n    gap: calc(6px * var(--space-scale, 1));\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    color: hsl(var(--primary-text));\n    padding: calc(4px * var(--space-scale, 1)) calc(10px * var(--space-scale, 1));\n    border-radius: 999px;\n    background: hsl(var(--primary) / 0.1);\n    margin-bottom: calc(8px * var(--space-scale, 1));\n  }\n\n  /* features band */\n  .wl-features .ds-page {\n    padding-top: calc(48px * var(--space-scale, 1));\n    padding-bottom: calc(64px * var(--space-scale, 1));\n  }\n  .wl-features-head {\n    max-width: 60ch;\n    margin-bottom: calc(32px * var(--space-scale, 1));\n  }\n  .wl-features-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: calc(32px * var(--space-scale, 1));\n    border-top: 1px solid hsl(var(--border));\n    padding-top: calc(32px * var(--space-scale, 1));\n  }\n  .wl-feature {\n    display: flex;\n    flex-direction: column;\n    gap: calc(8px * var(--space-scale, 1));\n  }\n  .wl-feature-num {\n    font-family: var(--font-heading);\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    color: hsl(var(--primary-text));\n    font-variant-numeric: tabular-nums;\n  }\n  .wl-feature-title {\n    font-family: var(--font-heading);\n    font-size: 18px;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n    color: hsl(var(--foreground));\n  }\n  .wl-feature-text {\n    font-size: 15px;\n    line-height: 1.5;\n    color: hsl(var(--muted-foreground));\n    margin: 0;\n  }\n\n  /* signed out message sits in the actions area */\n  .wl-signed-out {\n    display: inline-flex;\n    align-items: center;\n    gap: calc(8px * var(--space-scale, 1));\n    font-size: 15px;\n    font-weight: 600;\n    color: hsl(var(--success-soft-foreground));\n    background: hsl(var(--success-soft));\n    padding: calc(8px * var(--space-scale, 1)) calc(14px * var(--space-scale, 1));\n    border-radius: var(--radius);\n  }\n  .wl-signed-out svg { width: 18px; height: 18px; flex: none; }\n\n  .wl-foot {\n    display: flex;\n    align-items: center;\n    gap: calc(12px * var(--space-scale, 1));\n    padding-top: calc(24px * var(--space-scale, 1));\n    padding-bottom: calc(24px * var(--space-scale, 1));\n    font-size: 13px;\n    color: hsl(var(--muted-foreground));\n  }\n  .wl-foot .ds-brand-link { display: inline-flex; align-items: center; }\n\n  @media (max-width: 900px) {\n    .wl-hero-grid { grid-template-columns: minmax(0, 1fr); gap: calc(32px * var(--space-scale, 1)); }\n    .wl-preview-wrap { padding: 0; }\n    .wl-features-grid { grid-template-columns: minmax(0, 1fr); gap: calc(24px * var(--space-scale, 1)); }\n    .wl-feature { padding-bottom: calc(24px * var(--space-scale, 1)); border-bottom: 1px solid hsl(var(--border)); }\n    .wl-feature:last-child { padding-bottom: 0; border-bottom: 0; }\n  }\n  @media (max-width: 520px) {\n    .wl-hero .ds-page { padding-top: calc(40px * var(--space-scale, 1)); padding-bottom: calc(48px * var(--space-scale, 1)); }\n    .wl-actions .ds-btn { width: 100%; justify-content: center; }\n    .wl-top-bar { flex-wrap: wrap; }\n    .wl-top-right { gap: calc(8px * var(--space-scale, 1)); }\n    .wl-task { grid-template-columns: 24px minmax(0, 1fr); }\n    .wl-trash { display: none; }\n  }\n</style><main data-screen=\"welcome\" data-eid=\"e1\">\n  <header class=\"wl-top\" data-eid=\"e2\">\n    <div class=\"ds-bar wl-top-bar\" data-eid=\"e3\">\n      <a class=\"ds-brand-link\" data-goto=\"home\" data-eid=\"e4\"><img class=\"ds-brand ds-brand-light\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/4db7d9fa-5751-4d03-a387-a03389ae8786/66bc4fc6-9829-4297-b579-36b98cd4b1c2/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e5\"><img class=\"ds-brand ds-brand-dark\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/f2f6488c-a0c3-4e6a-9786-e726fff29e15/106500fc-0028-44d1-a371-c9fae6669afd/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e6\"></a>\n      <div class=\"wl-top-right\" data-eid=\"e7\">\n        <div class=\"ds-theme-switch\" role=\"group\" aria-label=\"Colour mode\" data-eid=\"e8\">\n          <button class=\"ds-active\" aria-label=\"Light\" data-eid=\"e9\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4\"></path></svg></button>\n          <button aria-label=\"Dark\" data-eid=\"e10\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z\"></path></svg></button>\n          <button aria-label=\"Auto\" data-eid=\"e11\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"12\" cy=\"12\" r=\"8\"></circle><path d=\"M12 4a8 8 0 0 1 0 16Z\" fill=\"currentColor\"></path></svg></button>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <div data-eid=\"content\">\n    <section class=\"wl-hero\" data-eid=\"e12\">\n      <div class=\"ds-deco\" style=\"top: -120px; right: -80px; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle at 40% 40%, hsl(var(--primary) / 0.12), transparent 70%);\" data-eid=\"e13\"></div>\n      <div class=\"ds-deco\" style=\"bottom: -160px; left: -120px; width: 380px; height: 380px; border-radius: 50%; border: 1px solid hsl(var(--primary) / 0.14);\" data-eid=\"e14\"></div>\n      <div class=\"ds-page\" data-eid=\"e15\">\n        <div class=\"wl-hero-grid\" data-eid=\"e16\">\n          <div data-eid=\"e17\">\n            <span class=\"ds-eyebrow\" data-sample=\"\" data-eid=\"e18\">A personal task list</span>\n            <h1 class=\"ds-h1 wl-promise\" style=\"font-size: clamp(44px, 7.2vw, 84px);\" data-eid=\"e19\"><span data-sample=\"\" data-eid=\"e20\">Plan. Focus.</span><span class=\"wl-word-accent\" data-sample=\"\" data-eid=\"e21\">Achieve.</span></h1>\n            <p class=\"wl-lede\" data-sample=\"\" data-eid=\"e22\">Add what needs doing, set a due date, check it off when it's done. Your list stays yours and no one else sees it.</p>\n\n            <div id=\"opening-actions\" data-eid=\"e23\">\n              <div class=\"wl-actions\" data-eid=\"e24\">\n                <button class=\"ds-btn ds-btn-lg\" data-goto=\"home\" data-eid=\"e25\">\n                  Sign in or create an account\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" style=\"width:18px;height:18px\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg>\n                </button>\n                <span class=\"wl-note\" data-eid=\"e26\">\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>\n                  <span data-sample=\"\" data-eid=\"e27\">New accounts start with 3 sample tasks.</span>\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"wl-preview-wrap\" data-eid=\"e28\">\n            <div class=\"wl-preview\" aria-label=\"A sample of your task list\" data-eid=\"e29\">\n              <div class=\"wl-preview-head\" data-eid=\"e30\">\n                <span class=\"wl-preview-title\" data-eid=\"e31\">Today's list</span>\n                <span class=\"wl-preview-count\" data-sample=\"\" data-eid=\"e32\">2 of 3 done</span>\n              </div>\n              <div class=\"wl-tasks\" data-eid=\"e33\">\n                <div class=\"wl-task is-done\" data-eid=\"e34\">\n                  <span class=\"wl-box\" data-eid=\"e35\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"></path></svg></span>\n                  <div class=\"wl-task-text\" data-eid=\"e36\">\n                    <span class=\"wl-task-title\" data-sample=\"\" data-eid=\"e37\">Finish project report</span>\n                    <div class=\"wl-task-sub\" data-eid=\"e38\">\n                      <span class=\"wl-task-date\" data-sample=\"\" data-eid=\"e39\">Yesterday</span>\n                      <span class=\"ds-badge ds-badge-success\" data-eid=\"e40\">Completed</span>\n                    </div>\n                  </div>\n                  <span class=\"wl-trash\" aria-hidden=\"true\" data-eid=\"e41\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5M14 11v5\"></path></svg></span>\n                </div>\n                <div class=\"wl-task\" data-eid=\"e42\">\n                  <span class=\"wl-box\" aria-hidden=\"true\" data-eid=\"e43\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"m5 12 5 5 9-10\"></path></svg></span>\n                  <div class=\"wl-task-text\" data-eid=\"e44\">\n                    <span class=\"wl-task-title\" data-sample=\"\" data-eid=\"e45\">Read a book</span>\n                    <div class=\"wl-task-sub\" data-eid=\"e46\">\n                      <span class=\"wl-task-date\" data-sample=\"\" data-eid=\"e47\">Today</span>\n                      <span class=\"ds-badge ds-badge-info\" data-eid=\"e48\">Pending</span>\n                    </div>\n                  </div>\n                  <span class=\"wl-trash\" aria-hidden=\"true\" data-eid=\"e49\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5M14 11v5\"></path></svg></span>\n                </div>\n                <div class=\"wl-task is-done\" data-eid=\"e50\">\n                  <span class=\"wl-box\" data-eid=\"e51\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"></path></svg></span>\n                  <div class=\"wl-task-text\" data-eid=\"e52\">\n                    <span class=\"wl-task-title\" data-sample=\"\" data-eid=\"e53\">Go for a walk</span>\n                    <div class=\"wl-task-sub\" data-eid=\"e54\">\n                      <span class=\"wl-task-date\" data-sample=\"\" data-eid=\"e55\">Tomorrow</span>\n                      <span class=\"ds-badge ds-badge-success\" data-eid=\"e56\">Completed</span>\n                    </div>\n                  </div>\n                  <span class=\"wl-trash\" aria-hidden=\"true\" data-eid=\"e57\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5M14 11v5\"></path></svg></span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"wl-band wl-features\" data-eid=\"e58\">\n      <div class=\"ds-page\" data-eid=\"e59\">\n        <div class=\"wl-features-head\" data-eid=\"e60\">\n          <h2 class=\"ds-h2\" data-eid=\"e61\">A list that keeps up</h2>\n          <p class=\"ds-muted\" style=\"margin: calc(8px * var(--space-scale, 1)) 0 0\" data-eid=\"e62\">Everything you add stays on one dashboard, with the numbers to match.</p>\n        </div>\n        <div class=\"wl-features-grid\" data-eid=\"e63\">\n          <div class=\"wl-feature\" data-eid=\"e64\">\n            <span class=\"wl-feature-num\" data-eid=\"e65\">01</span>\n            <span class=\"wl-feature-title\" data-eid=\"e66\">Add and check off</span>\n            <p class=\"wl-feature-text\" data-eid=\"e67\">Type a task, pick a date, and it lands at the end of your list. One click marks it done in place, green with a check mark.</p>\n          </div>\n          <div class=\"wl-feature\" data-eid=\"e68\">\n            <span class=\"wl-feature-num\" data-eid=\"e69\">02</span>\n            <span class=\"wl-feature-title\" data-eid=\"e70\">Filter in a tap</span>\n            <p class=\"wl-feature-text\" data-eid=\"e71\">Switch between All, Pending and Completed. Each tab shows its count, so you always know what's left.</p>\n          </div>\n          <div class=\"wl-feature\" data-eid=\"e72\">\n            <span class=\"wl-feature-num\" data-eid=\"e73\">03</span>\n            <span class=\"wl-feature-title\" data-eid=\"e74\">Know where you stand</span>\n            <p class=\"wl-feature-text\" data-eid=\"e75\">Statistics reads straight from your list: total tasks, completed and pending, with the share of the day behind you.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <footer data-eid=\"e76\">\n    <div class=\"ds-bar wl-foot\" data-eid=\"e77\">\n      <a class=\"ds-brand-link\" data-goto=\"home\" data-eid=\"e78\"><img class=\"ds-brand ds-brand-light\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/4db7d9fa-5751-4d03-a387-a03389ae8786/66bc4fc6-9829-4297-b579-36b98cd4b1c2/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e79\"><img class=\"ds-brand ds-brand-dark\" src=\"https://blocksdev.blob.core.windows.net/d37088d949337437ea80c61bce50dfd50/Public/f2f6488c-a0c3-4e6a-9786-e726fff29e15/106500fc-0028-44d1-a371-c9fae6669afd/pikachu.png\" alt=\"Quick Task Manager\" data-eid=\"e80\"></a>\n      <span class=\"ds-spacer\" data-eid=\"e81\"></span>\n      <span data-sample=\"\" data-eid=\"e82\">Plan. Focus. Achieve.</span>\n    </div>\n  </footer>\n\n  <section data-state=\"signed-out\" data-replaces=\"content\" hidden=\"\" data-root-class=\"is-signed-out\" data-eid=\"e83\">\n    <section class=\"wl-hero\" data-eid=\"e84\">\n      <div class=\"ds-deco\" style=\"top: -120px; right: -80px; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle at 40% 40%, hsl(var(--primary) / 0.12), transparent 70%);\" data-eid=\"e85\"></div>\n      <div class=\"ds-page\" data-eid=\"e86\">\n        <div class=\"wl-hero-grid\" data-eid=\"e87\">\n          <div data-eid=\"e88\">\n            <span class=\"ds-eyebrow\" data-eid=\"e89\">Personal task list</span>\n            <h1 class=\"ds-h1 wl-promise\" style=\"font-size: clamp(44px, 7.2vw, 84px);\" data-eid=\"e90\">Plan. Focus.<span class=\"wl-word-accent\" data-eid=\"e91\">Achieve.</span></h1>\n            <p class=\"wl-lede\" data-eid=\"e92\">Add what needs doing, set a due date, check it off when it's done. Your list stays yours and no one else sees it.</p>\n            <div class=\"wl-actions\" data-eid=\"e93\">\n              <span class=\"wl-signed-out\" data-eid=\"e94\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9\"></path></svg>\n                You're signed out.\n              </span>\n              <button class=\"ds-btn ds-btn-lg\" data-goto=\"home\" data-eid=\"e95\">\n                Sign in or create an account\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" style=\"width:18px;height:18px\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg>\n              </button>\n            </div>\n          </div>\n          <div class=\"wl-preview-wrap\" data-eid=\"e96\">\n            <div class=\"wl-preview\" aria-label=\"A sample of your task list\" data-eid=\"e97\">\n              <div class=\"wl-preview-head\" data-eid=\"e98\">\n                <span class=\"wl-preview-title\" data-eid=\"e99\">Today's list</span>\n                <span class=\"wl-preview-count\" data-eid=\"e100\">2 of 3 done</span>\n              </div>\n              <div class=\"wl-tasks\" data-eid=\"e101\">\n                <div class=\"wl-task is-done\" data-eid=\"e102\">\n                  <span class=\"wl-box\" data-eid=\"e103\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"></path></svg></span>\n                  <div class=\"wl-task-text\" data-eid=\"e104\">\n                    <span class=\"wl-task-title\" data-eid=\"e105\">Finish project report</span>\n                    <div class=\"wl-task-sub\" data-eid=\"e106\">\n                      <span class=\"wl-task-dat